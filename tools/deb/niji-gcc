#!/bin/sh
# niji-gcc / niji-g++: build a program against libniji from the reference packages
# (docs/install-packages.md; package niji6-dev). Installed as /usr/bin/niji-gcc, with
# /usr/bin/niji-g++ a link to it; the name picks the language.
#
# Compiling uses libniji's own C headers (plan/headers.md slice 20), never the system's: -nostdinc,
# then (C++ only) the C++ library's directories as the compiler lists them, the sysroot's
# usr/include/x86_64-linux-gnu and usr/include (libniji's headers, and links to the kernel UAPI
# headers of linux-libc-dev), then the compiler's own include directory. A program's -I and
# -isystem directories come first, as with the system compiler. With -nostdinc among the
# arguments nothing is added; with -nostdinc++ the C++ library's directories are left out.
# NIJI_SYSTEM_HEADERS=1 compiles with the system's headers instead (libniji is ABI-compatible
# with the glibc 2.39 headers), as before slice 20.
# Linking uses only libniji's start files and libraries from the sysroot /usr/lib/niji (the link
# editor runs with --sysroot, so the linker scripts there resolve inside it) and sets the program
# interpreter to libniji's loader, so the program starts on libniji, never on the system's C library:
#
#   dynamic (default)  PT_INTERP /usr/lib/niji/lib64/ld-linux-x86-64.so.2, Scrt1.o, libc.so
#   -static            crt1.o, libc.a (no interpreter)
#   -shared            a shared object linked against libniji's libc.so (for dlopen or linking)
#
# C++ (niji-g++) links libstdc++ and the unwinder statically, so the program's run-time library
# search never leaves the sysroot. A dynamic program (C or C++) also links niji-unwinder.o and
# exports its entry __niji_program_unwinder: a thread that exits or is cancelled with destructors,
# catch handlers or -fexceptions cleanups on its stack unwinds with the program's own unwinder
# when no libgcc_s.so.1 is loaded (D-22.24); a program without unwind code links no unwinder for it. Other libraries (-lz, ...) are the program's choice: the loader's
# default search is the sysroot only, so a program that needs a system library names its directory
# (-Wl,-rpath,DIR). Not supported: -static-pie, -pg (no profiling start file is packaged).
#
# Environment: NIJI_REAL_CC (default gcc) and NIJI_REAL_CXX (default g++) are the compilers;
# NIJI_SYSROOT (default /usr/lib/niji) is where the link-time files are read from (to build
# from an unpacked package tree); the program interpreter is always the installed loader.
set -eu
interp=/usr/lib/niji/lib64/ld-linux-x86-64.so.2
sysroot=${NIJI_SYSROOT:-/usr/lib/niji}
lib=$sysroot/usr/lib/x86_64-linux-gnu

case ${0##*/} in
    *++) cc=${NIJI_REAL_CXX:-g++}; cxx=yes ;;
    *) cc=${NIJI_REAL_CC:-gcc}; cxx=no ;;
esac

# The header search path (appended: a program's own -I/-isystem directories, given earlier, stay
# first). The language is C++ for niji-g++, after `-x c++`, or for a C++ source name.
inc=$sysroot/usr/include
lang=c; [ $cxx = yes ] && lang=c++
hdr=yes; cxxdirs=yes; prev=""
[ -n "${NIJI_SYSTEM_HEADERS:-}" ] && hdr=no
for a in "$@"; do
    case $prev:$a in
        -x:c++ | *:-xc++ | *:*.cc | *:*.cp | *:*.cxx | *:*.cpp | *:*.CPP | *:*.c++ | *:*.C | *:*.ii) lang=c++ ;;
    esac
    case $a in
        -nostdinc) hdr=no ;;
        -nostdinc++) cxxdirs=no ;;
    esac
    prev=$a
done
if [ $hdr = yes ]; then
    if [ ! -f "$inc/features.h" ]; then
        echo "niji-gcc: $inc/features.h is missing (install niji6-dev, or set NIJI_SYSTEM_HEADERS=1)" >&2
        exit 1
    fi
    gccinc=$("$cc" -print-file-name=include)
    set -- "$@" -nostdinc
    if [ $lang = c++ ] && [ $cxxdirs = yes ]; then
        # The compiler's own search list (its -v report), C++ library directories only.
        for d in $("$cc" -x c++ -E -v - </dev/null 2>&1 | sed -n '/^#include <\.\.\.> search starts here:/,/^End of search list\./s/^ \(.*\/c++\/.*\)/\1/p'); do
            set -- "$@" -isystem "$d"
        done
    fi
    set -- "$@" -isystem "$inc/x86_64-linux-gnu" -isystem "$inc" -isystem "$gccinc"
fi

mode=dynamic
for a in "$@"; do
    case $a in
        -c | -S | -E | -M | -MM) exec "$cc" "$@" ;;
        -static) mode=static ;;
        -shared) mode=shared ;;
        -static-pie | -pg)
            echo "niji-gcc: $a is not supported (docs/install-packages.md)" >&2
            exit 2 ;;
    esac
done

if [ ! -f "$lib/libc.so.6" ]; then
    echo "niji-gcc: $lib/libc.so.6 is missing (install niji6)" >&2
    exit 1
fi

# The compiler's own start and end objects (crtbegin/crtend), as its own link would pick them.
case $mode in
    static) begin=$("$cc" -print-file-name=crtbeginT.o); end=$("$cc" -print-file-name=crtend.o) ;;
    *) begin=$("$cc" -print-file-name=crtbeginS.o); end=$("$cc" -print-file-name=crtendS.o) ;;
esac

# Drop -static/-shared (given again below); keep everything else in order.
n=$#
i=0
while [ $i -lt $n ]; do
    a=$1
    shift
    i=$((i + 1))
    case $a in
        -static | -shared) ;;
        *) set -- "$@" "$a" ;;
    esac
done

if [ $cxx = yes ]; then
    cxxlibs="-Wl,-Bstatic -lstdc++ -Wl,-Bdynamic -lm"
    [ $mode = static ] && cxxlibs="-lstdc++ -lm"
else
    cxxlibs=""
fi

# `-x none`: a `-x LANG` among the program's arguments must not make the files added here sources.
# shellcheck disable=SC2086
case $mode in
    dynamic)
        exec "$cc" -nostartfiles -nodefaultlibs "-Wl,--sysroot=$sysroot" "-Wl,--dynamic-linker=$interp" -L"$lib" \
            -Wl,--export-dynamic-symbol=__niji_program_unwinder \
            -x none "$lib/Scrt1.o" "$begin" "$@" -x none $cxxlibs -lc -lgcc -lgcc_eh "$lib/niji-unwinder.o" "$end" ;;
    shared)
        exec "$cc" -shared -nostartfiles -nodefaultlibs "-Wl,--sysroot=$sysroot" -L"$lib" \
            -x none "$begin" "$@" -x none $cxxlibs -lc -lgcc "$end" ;;
    static)
        # --eh-frame-hdr: the unwinder finds a static program's frame tables through its
        # PT_GNU_EH_FRAME header (as the conformance suite's static C++ programs link).
        exec "$cc" -static -nostdlib "-Wl,--sysroot=$sysroot" -Wl,--eh-frame-hdr -L"$lib" \
            -x none "$lib/crt1.o" "$begin" "$@" -x none $cxxlibs -Wl,--start-group -lc -lgcc -lgcc_eh -Wl,--end-group "$end" ;;
esac
