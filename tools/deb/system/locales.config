#!/bin/sh
# locales (libniji) debconf config script (UTIL-LOCALE-GEN, D-31.37): ask which locales to compile
# and which one the system environment uses (debconf-devel(7)). The current answers come from the
# system: the selected lines of /etc/locale.gen, and LANG in /etc/locale.conf.
set -e
. /usr/share/debconf/confmodule

gen=/etc/locale.gen
supported=/usr/share/i18n/SUPPORTED
conf=/etc/locale.conf

# join: standard input's lines as one debconf list, "a, b, c".
join() {
    sed -e ':a' -e 'N' -e '$!ba' -e 's/\n/, /g'
}

# The selected entries of /etc/locale.gen, "<locale> <charset>" each, sorted.
selected=
if [ -e "$gen" ]; then
    selected=$(sed -n 's/^[[:blank:]]*\([^#[:blank:]][^[:blank:]]*\)[[:blank:]]\{1,\}\([^[:blank:]#][^[:blank:]]*\).*/\1 \2/p' "$gen" |
        LC_ALL=C sort -u | join)
    db_set locales/locales_to_be_generated "$selected"
fi
# The choices: every SUPPORTED entry and every selected one (a selected locale SUPPORTED lacks stays
# a choice).
choices=$({
    sed -n 's/^\([^#[:blank:]][^[:blank:]]*\)[[:blank:]]\{1,\}\([^[:blank:]]*\).*/\1 \2/p' "$supported" 2>/dev/null
    printf '%s\n' "$selected" | sed 's/, */\
/g'
} | sed '/^$/d' | LC_ALL=C sort -u | join)
db_subst locales/locales_to_be_generated locales "$choices"
db_input medium locales/locales_to_be_generated || true
db_go || true

# The default: one of the locales now selected, or None.
db_get locales/locales_to_be_generated
names=$(printf '%s\n' "$RET" | sed 's/, */\
/g' | sed -n 's/^\([^ ][^ ]*\) .*/\1/p' | LC_ALL=C sort -u | join)
db_subst locales/default_environment_locale locales "$names"
current=$(sed -n 's/^[[:blank:]]*LANG=["]\{0,1\}\([^"]*\)["]\{0,1\}[[:blank:]]*$/\1/p' "$conf" 2>/dev/null | tail -n 1)
db_get locales/default_environment_locale
case ", $names, " in
    *", $RET, "*) ;;
    *)
        case ", $names, " in
            *", $current, "*) db_set locales/default_environment_locale "$current" ;;
            *) db_set locales/default_environment_locale None ;;
        esac
        ;;
esac
db_input medium locales/default_environment_locale || true
db_go || true

exit 0
