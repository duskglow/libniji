#!/bin/sh
# libc-bin (libniji) postinst. DPKG_ROOT is honoured, so dpkg --root --force-script-chrootless can
# configure an empty root that has no shell of its own (tools/deb/root-system.sh).
set -e

# Rebuild the soname links and /etc/ld.so.cache. ldconfig is static with no interpreter (D-31.2), so
# the root's own copy runs from outside the root as well; -r keeps every path it reads or writes
# inside DPKG_ROOT (resolved with openat2 RESOLVE_IN_ROOT, D-31.9).
run_ldconfig() {
    if [ -n "$DPKG_ROOT" ]; then
        "$DPKG_ROOT/usr/sbin/ldconfig" -r "$DPKG_ROOT"
    else
        /usr/sbin/ldconfig
    fi
}

case "$1" in
    configure)
        # /etc/nsswitch.conf is the administrator's file, not a conffile: installed once from the
        # template when the system has none, never replaced.
        if [ ! -e "$DPKG_ROOT/etc/nsswitch.conf" ]; then
            cp "$DPKG_ROOT/usr/share/libc-bin/nsswitch.conf" "$DPKG_ROOT/etc/nsswitch.conf"
            chmod 0644 "$DPKG_ROOT/etc/nsswitch.conf"
        fi
        # deb-triggers(5): an activation of the ldconfig trigger while libc-bin is not configured
        # (first install, upgrade, or the swap of plan/system-libc.md section 3.7, where libc6 is
        # unpacked in the same run) is not kept, since configuring the package is expected to do
        # the trigger's work. So configure runs ldconfig itself.
        run_ldconfig
        ;;
    triggered)
        # The ldconfig trigger (libc6 and library packages activate it).
        run_ldconfig
        ;;
esac

exit 0
