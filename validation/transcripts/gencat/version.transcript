name: -V prints the version banner, exit 0
clause: s31_1_c_2
command: gencat
namespace: none
# The version banner is an identity string (Q3 of plan/utilities.md, D-31.4).
env: LC_ALL=C.UTF-8
normalise: gencat (Ubuntu GLIBC 2.39-0ubuntu8.9) 2.39\nCopyright (C) 2024 Free Software Foundation, Inc.\nThis is free software; see the source for copying conditions.  There is NO\nwarranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.\nWritten by Ulrich Drepper.\n => gencat (libniji) 2.39\n
arg: -V
status: exit 0
stdout:
| gencat (libniji) 2.39
stderr:
