name: -o compiles a source into a catalog (byte comparison)
clause: s31_12_c_1
clause: s31_12_g_1
command: gencat
namespace: none
env: LC_ALL=C.UTF-8
file: i.msg
| $ a comment
| $set 1
| 1 Hello, world
| 2 second message
| $set 2
| 1 another set
arg: --new
arg: -o
arg: o.cat
arg: i.msg
status: exit 0
