name: locale --usage
clause: s31_7_i_1
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
arg: --usage
status: exit 0
stdout:
| Usage: locale [-ckv?V] [--category-name] [--keyword-name] [--verbose] [--help]
| \x20           [--usage] [--version] NAME
| \x20 or:  locale [OPTION...] [-a|-m]
stderr:
