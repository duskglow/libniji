name: locale -m over a private charmap directory
clause: s31_7_g_3
command: locale
namespace: user
# A private charmap directory: plain and gzip charmaps (stored, fixed and dynamic deflate blocks), one
# without <code_set_name>, a hidden file. Each charmap is listed by file name and by <code_set_name>.
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
file: i18n/charmaps/PLAIN
| <comment_char> %
| <escape_char> /
| <code_set_name> PLAIN-SET
| <mb_cur_min> 1
| <mb_cur_max> 1
| CHARMAP
| <U0041>     /x41         LATIN CAPITAL LETTER A
| END CHARMAP
file: i18n/charmaps/NOCODE
| <comment_char> %
| <escape_char> /
| <mb_cur_min> 1
| <mb_cur_max> 1
| CHARMAP
| <U0041>     /x41         LATIN CAPITAL LETTER A
| END CHARMAP
file: i18n/charmaps/.hidden-map
| <comment_char> %
| <escape_char> /
| <code_set_name> HIDDEN-SET
| <mb_cur_min> 1
| <mb_cur_max> 1
| CHARMAP
| <U0041>     /x41         LATIN CAPITAL LETTER A
| END CHARMAP
file: i18n/charmaps/STORED.gz
| \x1f\x8b\x08\x00\x00\x00\x00\x00\x00\x03\x01\x9e\x00a\xff<comment_char> %
| <escape_char> /
| <code_set_name> STORED-SET
| <mb_cur_min> 1
| <mb_cur_max> 1
| CHARMAP
| <U0041>     /x41         LATIN CAPITAL LETTER A
| END CHARMAP
|~ Jp\x921\x9e\x00\x00\x00
