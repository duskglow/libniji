name: locale -ck LC_ADDRESS in C
clause: s31_7_g_4
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
env: LC_ALL=C
arg: -ck
arg: LC_ADDRESS
status: exit 0
stdout:
| LC_ADDRESS
| postal_fmt="%a%N%f%N%d%N%b%N%s %h %e %r%N%C-%z %T%N%c%N"
| country_name=""
| country_post=""
| country_ab2=""
| country_ab3=""
| country_car=""
| country_num=0
| country_isbn=""
| lang_name=""
| lang_ab=""
| lang_term=""
| lang_lib=""
| address-codeset="ANSI_X3.4-1968"
stderr:
