name: locale -k LC_CTYPE keywords of C outside the class and map tables
clause: s31_7_g_4
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
env: LC_ALL=C
arg: -k
arg: ctype-mb-cur-max
arg: charmap
arg: ctype-outdigit0-mb
arg: ctype-translit-default-missing-len
status: exit 1
stdout:
| ctype-mb-cur-max=1
| charmap="ANSI_X3.4-1968"
stderr:
| locale: unknown name "ctype-outdigit0-mb"
