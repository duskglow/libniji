name: locale -ck LC_NAME in C
clause: s31_7_g_4
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
env: LC_ALL=C
arg: -ck
arg: LC_NAME
status: exit 0
stdout:
| LC_NAME
| name_fmt="%p%t%g%t%m%t%f"
| name_gen=""
| name_mr=""
| name_mrs=""
| name_miss=""
| name_ms=""
| name-codeset="ANSI_X3.4-1968"
stderr:
