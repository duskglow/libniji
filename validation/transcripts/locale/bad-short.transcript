name: locale an unknown short option
clause: s31_7_i_1
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
arg: -x
status: exit 64
stdout:
stderr:
| locale: invalid option -- 'x'
| Try `locale --help' or `locale --usage' for more information.
