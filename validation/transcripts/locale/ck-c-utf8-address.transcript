name: locale -ck LC_ADDRESS in C.UTF-8
clause: s31_7_g_4
command: locale
namespace: user
# The installed C.utf8 (part of the C library package on every system; the reference has no built-in C.UTF-8).
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
env: LC_ALL=C.UTF-8
arg: -ck
arg: LC_ADDRESS
status: exit 0
stdout:
| LC_ADDRESS
| postal_fmt="%a%N%f%N%d%N%b%N%s %h %e %r%N%C-%z %T%N%c%N"
| country_name=""
| country_post=""
| country_ab2=""
| country_ab3=""
| country_car=""
| country_num=0
| country_isbn=""
| lang_name=""
| lang_ab=""
| lang_term=""
| lang_lib=""
| address-codeset="UTF-8"
stderr:
