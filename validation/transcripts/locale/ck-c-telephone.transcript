name: locale -ck LC_TELEPHONE in C
clause: s31_7_g_4
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
env: LC_ALL=C
arg: -ck
arg: LC_TELEPHONE
status: exit 0
stdout:
| LC_TELEPHONE
| tel_int_fmt="+%c %a %l"
| tel_dom_fmt=""
| int_select=""
| int_prefix=""
| telephone-codeset="ANSI_X3.4-1968"
stderr:
