name: locale a unique long-option prefix
clause: s31_7_i_1
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
env: LC_ALL=C
arg: --keyword
arg: decimal_point
status: exit 0
stdout:
| decimal_point="."
stderr:
