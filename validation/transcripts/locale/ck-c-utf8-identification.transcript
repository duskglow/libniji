name: locale -ck LC_IDENTIFICATION in C.UTF-8
clause: s31_7_g_4
command: locale
namespace: user
# The installed C.utf8 (part of the C library package on every system; the reference has no built-in C.UTF-8).
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
# libniji prints exactly the item's own data for category (docs/differences-from-glibc.md,
# ruling #6247).
normalise: \ncategory="i18n:2012;UTF-8;;;;;;;;;;;"\n => \ncategory="i18n:2012"\n
env: LC_ALL=C.UTF-8
arg: -ck
arg: LC_IDENTIFICATION
status: exit 0
stdout:
| LC_IDENTIFICATION
| title="C locale"
| source=""
| address=""
| contact=""
| email="bug-glibc-locales@gnu.org"
| tel=""
| fax=""
| language=""
| territory=""
| audience=""
| application=""
| abbreviation=""
| revision="2.1"
| date="2022-01-30"
| category="i18n:2012"
| identification-codeset="UTF-8"
stderr:
