name: locale an unknown name
clause: s31_7_f_1
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
arg: no_such_keyword
status: exit 1
stdout:
stderr:
| locale: unknown name "no_such_keyword"
