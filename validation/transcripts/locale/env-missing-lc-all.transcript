name: locale with LC_ALL naming a locale that is not installed
clause: s31_7_f_2
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
env: LC_ALL=xx_XX.UTF-8
status: exit 0
stdout:
| LANG=
| LANGUAGE=
| LC_CTYPE="xx_XX.UTF-8"
| LC_NUMERIC="xx_XX.UTF-8"
| LC_TIME="xx_XX.UTF-8"
| LC_COLLATE="xx_XX.UTF-8"
| LC_MONETARY="xx_XX.UTF-8"
| LC_MESSAGES="xx_XX.UTF-8"
| LC_PAPER="xx_XX.UTF-8"
| LC_NAME="xx_XX.UTF-8"
| LC_ADDRESS="xx_XX.UTF-8"
| LC_TELEPHONE="xx_XX.UTF-8"
| LC_MEASUREMENT="xx_XX.UTF-8"
| LC_IDENTIFICATION="xx_XX.UTF-8"
| LC_ALL=xx_XX.UTF-8
stderr:
| locale: Cannot set LC_CTYPE to default locale: No such file or directory
| locale: Cannot set LC_MESSAGES to default locale: No such file or directory
| locale: Cannot set LC_ALL to default locale: No such file or directory
