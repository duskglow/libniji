name: locale -ck LC_TIME in C.UTF-8
clause: s31_7_g_4
command: locale
namespace: user
# The installed C.utf8 (part of the C library package on every system; the reference has no built-in C.UTF-8).
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
# libniji prints exactly the item's own data for time-era-entries (docs/differences-from-glibc.md,
# ruling #6247).
normalise: \ntime-era-entries="S"\n => \ntime-era-entries=""\n
env: LC_ALL=C.UTF-8
arg: -ck
arg: LC_TIME
status: exit 0
stdout:
| LC_TIME
| abday="Sun;Mon;Tue;Wed;Thu;Fri;Sat"
| day="Sunday;Monday;Tuesday;Wednesday;Thursday;Friday;Saturday"
| abmon="Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec"
| mon="January;February;March;April;May;June;July;August;September;October;November;December"
| am_pm="AM;PM"
| d_t_fmt="%a %b %e %H:%M:%S %Y"
| d_fmt="%m/%d/%y"
| t_fmt="%H:%M:%S"
| t_fmt_ampm="%I:%M:%S %p"
| era=
| era_year=""
| era_d_fmt=""
| alt_digits=
| era_d_t_fmt=""
| era_t_fmt=""
| time-era-num-entries=0
| time-era-entries=""
| week-ndays=7
| week-1stday=19971130
| week-1stweek=4
| first_weekday=1
| first_workday=2
| cal_direction=1
| timezone=""
| date_fmt="%a %b %e %H:%M:%S %Z %Y"
| time-codeset="UTF-8"
| alt_mon="January;February;March;April;May;June;July;August;September;October;November;December"
| ab_alt_mon="Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec"
stderr:
