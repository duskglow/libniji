name: locale -ck keywords from several categories
clause: s31_7_g_4
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
env: LC_ALL=C
arg: -ck
arg: mon_grouping
arg: LC_MEASUREMENT
arg: d_t_fmt
arg: yesexpr
status: exit 0
stdout:
| LC_MONETARY
| mon_grouping=-1
| LC_MEASUREMENT
| measurement=1
| measurement-codeset="ANSI_X3.4-1968"
| LC_TIME
| d_t_fmt="%a %b %e %H:%M:%S %Y"
| LC_MESSAGES
| yesexpr="^[yY]"
stderr:
