name: locale -m without a charmap directory
clause: s31_7_g_3
command: locale
namespace: user
# A private /usr/share/i18n without charmaps/.
dir: i18n
bind: i18n /usr/share/i18n
dir: loc
bind: loc /usr/lib/locale
arg: -m
status: exit 1
stdout:
stderr:
| locale: [error] cannot read character map directory `/usr/share/i18n/charmaps': No such file or directory
