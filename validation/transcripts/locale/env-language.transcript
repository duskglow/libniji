name: locale with LANGUAGE
clause: s31_7_i_2
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
env: LANGUAGE=fr:de
env: LANG=C
status: exit 0
stdout:
| LANG=C
| LANGUAGE=fr:de
| LC_CTYPE="C"
| LC_NUMERIC="C"
| LC_TIME="C"
| LC_COLLATE="C"
| LC_MONETARY="C"
| LC_MESSAGES="C"
| LC_PAPER="C"
| LC_NAME="C"
| LC_ADDRESS="C"
| LC_TELEPHONE="C"
| LC_MEASUREMENT="C"
| LC_IDENTIFICATION="C"
| LC_ALL=
stderr:
