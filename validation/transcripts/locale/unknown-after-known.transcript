name: locale a known keyword, then two unknown names
clause: s31_7_f_1
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
arg: -k
arg: decimal_point
arg: bogus1
arg: bogus2
status: exit 1
stdout:
| decimal_point="."
stderr:
| locale: unknown name "bogus1"
