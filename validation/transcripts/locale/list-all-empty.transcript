name: locale -a with an empty locale directory
clause: s31_7_g_2
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist. C.utf8 holds a placeholder.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
dir: loc/C.utf8
file: loc/C.utf8/LC_IDENTIFICATION
| placeholder
arg: -a
status: exit 0
stdout:
| C
| C.utf8
| POSIX
stderr:
