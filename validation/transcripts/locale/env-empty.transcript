name: locale with no locale variables
clause: s31_7_g_1
command: locale
namespace: user
# Private, empty /usr/lib/locale and charmap directory: only the built-in C, C.UTF-8 and POSIX exist.
dir: loc
bind: loc /usr/lib/locale
dir: i18n
dir: i18n/charmaps
bind: i18n /usr/share/i18n
status: exit 0
stdout:
| LANG=
| LANGUAGE=
| LC_CTYPE="POSIX"
| LC_NUMERIC="POSIX"
| LC_TIME="POSIX"
| LC_COLLATE="POSIX"
| LC_MONETARY="POSIX"
| LC_MESSAGES="POSIX"
| LC_PAPER="POSIX"
| LC_NAME="POSIX"
| LC_ADDRESS="POSIX"
| LC_TELEPHONE="POSIX"
| LC_MEASUREMENT="POSIX"
| LC_IDENTIFICATION="POSIX"
| LC_ALL=
stderr:
