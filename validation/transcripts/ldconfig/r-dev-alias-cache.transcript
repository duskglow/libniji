link: opt/a/libcmocka.so.0 -> libcmocka.so.0.8.0
link: opt/a/libcmocka.so -> libcmocka.so.0
link: opt/a/libcmockery.so -> libcmocka.so
elf: opt/b/libfoo.so.1.0 soname=libfoo.so.1
link: opt/b/libfoo.so.1 -> libfoo.so.1.0
link: opt/b/libfoo-compat.so -> libfoo.so.1.0
elf: opt/c/libqux.so.2.0 soname=libqux.so.2
link: opt/c/libquxalt.so -> libqux.so.2.0
elf: opt/d/libbar.so soname=libbar.so.3
elf: opt/e/libbaz.so soname=libbaz.so
elf: opt/f/libup.so.1.0 soname=libup.so.1
elf: opt/f/libup.so.1.1 soname=libup.so.1
link: opt/f/libup.so.1 -> libup.so.1.0
link: opt/f/libup.so -> libup.so.1
link: opt/f/libupcompat.so -> libup.so
elf: opt/g/libsf.so.1.2 soname=libsf.so.1
link: opt/g/libsf.so.1 -> ./libsf.so.1.2
elf: opt/h/libqvx.so.2.0 soname=libqvx.so.2
link: opt/h/libqvx.so.2 -> libqvx.so.2.0
link: opt/h/libqvxalt.so -> libqvx.so.2.0
elf: opt/i/libv.so.1.0 soname=libv.so.1
elf: opt/i/libv.so.1.1 soname=libv.so.1
link: opt/i/libv.so.1 -> libv.so.1.0
dir: lib
dir: lib/x86_64-linux-gnu
dir: usr/lib
dir: usr/lib/x86_64-linux-gnu
