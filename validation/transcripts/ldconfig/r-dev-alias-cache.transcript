# -r ROOT with a cache: `.so` development names that are not a prefix of their soname, one case per directory (so -v
# does not depend on the order the reference lists a directory in):
# /opt/a  issue #16's layout, soname link present: an alias -> development link -> soname link -> real file;
# /opt/b  an alias that sorts below the real file, `libfoo-compat.so`, straight at it, soname link present;
# /opt/c  an alias that sorts above the real file, `libquxalt.so`, straight at it, no soname link before the run;
# /opt/d  a `.so` regular file with a versioned soname and no other file of that soname;
# /opt/e  a `.so` regular file whose soname is its own name;
# /opt/f  an upgrade: the soname link at the old version, a new version beside it, an alias through the links;
# /opt/g  a soname link whose text differs from the file's name but which reaches the same file;
# /opt/h  an alias that sorts above the real file, straight at it, soname link present;
# /opt/i  the soname link at an old version, a new version beside it, no alias: the link moves.
name: ldconfig -r ROOT -v never points a soname link at a .so development name and records the cache
clause: s31_2_g_4
clause: s31_2_c_1
# The reference is Debian's wrapper script, which execs /sbin/ldconfig.real: its program name is normalised.
normalise: /sbin/ldconfig.real => ldconfig
normalise: ldconfig.real => ldconfig
command: ldconfig
env: LC_ALL=C
arg: -r
arg: @ROOT@
arg: -v
as-cache: etc/ld.so.cache
file: etc/ld.so.conf
| /opt/a
| /opt/b
| /opt/c
| /opt/d
| /opt/e
| /opt/f
| /opt/g
| /opt/h
| /opt/i
