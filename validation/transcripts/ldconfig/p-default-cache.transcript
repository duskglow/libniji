# `ldconfig -p` without -C reads /etc/ld.so.cache. A Liella-written cache is mounted over it in a private user and
# mount namespace (the D.3 method); the command runs with the caller's own uid and gid.
name: ldconfig -p lists /etc/ld.so.cache in cache order, then the generator text
clause: s31_2_g_6
command: ldconfig
env: LC_ALL=C
arg: -p
namespace: user
bind: etc/ld.so.cache /etc/ld.so.cache
cache: etc/ld.so.cache
generator: Liella transcript test 2
