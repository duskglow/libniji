name: ldd zero-needed: a dynamic program with no needed library
clause: s31_3_g_1
command: ldd
arg: bin/zero
mask-addresses: yes
cc: bin/zero -nostdlib -fno-stack-protector -fno-asynchronous-unwind-tables -O1 -Wl,--build-id=none 
| void _start(void) { for (;;) {} }
status: exit 0
stdout:
| \tstatically linked
stderr:
