name: ldd not-found: a needed library not found is NAME => not found, exit 0
clause: s31_3_g_1
command: ldd
arg: bin/missing
mask-addresses: yes
env: LD_LIBRARY_PATH=@ROOT@/lib
cc: lib/libfoo.so.1 -nostdlib -fno-stack-protector -fno-asynchronous-unwind-tables -O1 -Wl,--build-id=none -shared -fPIC -Wl,-soname,libfoo.so.1
| int foo(void) { return 1; }
file: lib/bar.map
| BAR_1 { global: bar; local: *; };
| BAR_2 { global: bar2; } BAR_1;
cc: lib/libbar.so.2 -nostdlib -fno-stack-protector -fno-asynchronous-unwind-tables -O1 -Wl,--build-id=none -shared -fPIC -Wl,-soname,libbar.so.2 -Wl,--version-script=@ROOT@/lib/bar.map
| int bar(void) { return 2; }
| int bar2(void) { return 3; }
cc: lib/libbaz.so.3 -nostdlib -fno-stack-protector -fno-asynchronous-unwind-tables -O1 -Wl,--build-id=none -shared -fPIC -Wl,-soname,libbaz.so.3 -L@ROOT@/lib -l:libfoo.so.1
| int foo(void);
| int baz(void) { return foo(); }
cc: build/libgone.so.4 -nostdlib -fno-stack-protector -fno-asynchronous-unwind-tables -O1 -Wl,--build-id=none -shared -fPIC -Wl,-soname,libgone.so.4
| int gone(void) { return 4; }
cc: bin/missing -nostdlib -fno-stack-protector -fno-asynchronous-unwind-tables -O1 -Wl,--build-id=none -L@ROOT@/lib -L@ROOT@/build -l:libfoo.so.1 -l:libgone.so.4
| int foo(void);
| int gone(void);
| void _start(void) { foo(); gone(); for (;;) {} }
status: exit 0
stdout:
| \tlinux-vdso.so.1 (0x@ADDR@)
| \tlibfoo.so.1 => @ROOT@/lib/libfoo.so.1 (0x@ADDR@)
| \tlibgone.so.4 => not found
stderr:
