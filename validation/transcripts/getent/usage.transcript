name: getent --usage
clause: s31_1_c_2
command: getent
namespace: user
# A private /etc: nsswitch.conf names only the files service, so nothing depends on the host's
# configuration, network or name servers.
dir: etc
bind: etc /etc
file: etc/nsswitch.conf
| passwd: files
| group: files
| shadow: files
| gshadow: files
| hosts: files
| networks: files
| protocols: files
| services: files
| ethers: files
| rpc: files
| netgroup: files
| aliases: files
arg: --usage
status: exit 0
stdout:
| Usage: getent [-Ai?V] [-s CONFIG] [--no-addrconfig] [--no-idn]
| \x20           [--service=CONFIG] [--help] [--usage] [--version]
| \x20           database [key ...]
stderr:
