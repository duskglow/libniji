name: getent aliases enumerated, a name longer than the column
clause: s31_4_g_3
command: getent
namespace: user
# A private /etc: nsswitch.conf names only the files service, so nothing depends on the host's
# configuration, network or name servers.
dir: etc
bind: etc /etc
file: etc/nsswitch.conf
| passwd: files
| group: files
| shadow: files
| gshadow: files
| hosts: files
| networks: files
| protocols: files
| services: files
| ethers: files
| rpc: files
| netgroup: files
| aliases: files
file: etc/aliases
| postmaster: root
| admins: alice, bob
| averyveryverylongalias: root
arg: aliases
