name: getent rpc enumerated; entries with and without aliases, a long name
clause: s31_4_g_3
command: getent
namespace: user
# A private /etc: nsswitch.conf names only the files service, so nothing depends on the host's
# configuration, network or name servers.
dir: etc
bind: etc /etc
file: etc/nsswitch.conf
| passwd: files
| group: files
| shadow: files
| gshadow: files
| hosts: files
| networks: files
| protocols: files
| services: files
| ethers: files
| rpc: files
| netgroup: files
| aliases: files
file: etc/rpc
| portmapper\t100000\tportmap sunrpc rpcbind
| nfs\t\t100003\tnfsprog
| mountd\t\t100005
| verylongrpcname1234 100099 x
arg: rpc
