name: getent passwd by name and decimal uid; 0x3e8 and 1000x are names; one key missing gives 2
clause: s31_4_g_1
command: getent
namespace: user
# A private /etc: nsswitch.conf names only the files service, so nothing depends on the host's
# configuration, network or name servers.
dir: etc
bind: etc /etc
file: etc/nsswitch.conf
| passwd: files
| group: files
| shadow: files
| gshadow: files
| hosts: files
| networks: files
| protocols: files
| services: files
| ethers: files
| rpc: files
| netgroup: files
| aliases: files
file: etc/passwd
| root:x:0:0:root:/root:/bin/bash
| daemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin
| alice:x:1000:1000:Alice,,,:/home/alice:/bin/sh
| bob:x:1001:100::/home/bob:
arg: passwd
arg: root
arg: 1000
arg: +1000
arg: 0x3e8
arg: 1000x
arg: nobody
arg: bob
status: exit 2
stdout:
| root:x:0:0:root:/root:/bin/bash
| alice:x:1000:1000:Alice,,,:/home/alice:/bin/sh
| alice:x:1000:1000:Alice,,,:/home/alice:/bin/sh
| bob:x:1001:100::/home/bob:
stderr:
