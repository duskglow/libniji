name: getent --service=db:service, options after the database
clause: s31_4_i_2
command: getent
namespace: user
# A private /etc: nsswitch.conf names only the files service, so nothing depends on the host's
# configuration, network or name servers.
dir: etc
bind: etc /etc
file: etc/nsswitch.conf
| passwd: files
| group: files
| shadow: files
| gshadow: files
| hosts: files
| networks: files
| protocols: files
| services: files
| ethers: files
| rpc: files
| netgroup: files
| aliases: files
file: etc/group
| root:x:0:
| daemon:x:1:
| sudo:x:27:alice
| users:x:100:alice,bob
| alice:x:1000:
arg: group
arg: --service=group:files
arg: sudo
status: exit 0
stdout:
| sudo:x:27:alice
stderr:
