name: getent hosts by name (IPv6 first, then IPv4) and by address; missing name and address give 2
clause: s31_4_g_2
command: getent
namespace: user
# A private /etc: nsswitch.conf names only the files service, so nothing depends on the host's
# configuration, network or name servers.
dir: etc
bind: etc /etc
file: etc/nsswitch.conf
| passwd: files
| group: files
| shadow: files
| gshadow: files
| hosts: files
| networks: files
| protocols: files
| services: files
| ethers: files
| rpc: files
| netgroup: files
| aliases: files
file: etc/hosts
| 127.0.0.1\tlocalhost
| 127.0.1.1 box.example box
| ::1 localhost ip6-localhost ip6-loopback
| 192.0.2.5 www.example.org www
| 2001:db8::1 v6host
arg: hosts
arg: localhost
arg: box
arg: v6host
arg: 192.0.2.5
arg: 2001:db8:0::1
arg: ::1
arg: missing
arg: 10.9.9.9
status: exit 2
stdout:
| ::1             localhost ip6-localhost ip6-loopback
| 127.0.1.1       box.example box
| 2001:db8::1     v6host
| 192.0.2.5       www.example.org www
| 2001:db8::1     v6host
| ::1             localhost ip6-localhost ip6-loopback
stderr:
