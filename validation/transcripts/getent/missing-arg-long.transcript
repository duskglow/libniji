name: getent --service without its argument: exit 64
clause: s31_1_f_1
command: getent
namespace: user
# A private /etc: nsswitch.conf names only the files service, so nothing depends on the host's
# configuration, network or name servers.
dir: etc
bind: etc /etc
file: etc/nsswitch.conf
| passwd: files
| group: files
| shadow: files
| gshadow: files
| hosts: files
| networks: files
| protocols: files
| services: files
| ethers: files
| rpc: files
| netgroup: files
| aliases: files
arg: --service
status: exit 64
stdout:
stderr:
| getent: option '--service' requires an argument
| Try `getent --help' or `getent --usage' for more information.
