name: getent shadow by name, one missing
clause: s31_4_g_1
command: getent
namespace: user
# A private /etc: nsswitch.conf names only the files service, so nothing depends on the host's
# configuration, network or name servers.
dir: etc
bind: etc /etc
file: etc/nsswitch.conf
| passwd: files
| group: files
| shadow: files
| gshadow: files
| hosts: files
| networks: files
| protocols: files
| services: files
| ethers: files
| rpc: files
| netgroup: files
| aliases: files
file: etc/shadow
| root:*:19000:0:99999:7:::
| alice:$6$salt$hash:19000:0:99999:7:::
arg: shadow
arg: alice
arg: nope
status: exit 2
stdout:
| alice:$6$salt$hash:19000:0:99999:7:::
stderr:
