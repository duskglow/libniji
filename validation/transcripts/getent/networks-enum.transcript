name: getent networks enumerated
clause: s31_4_g_3
command: getent
namespace: user
# A private /etc: nsswitch.conf names only the files service, so nothing depends on the host's
# configuration, network or name servers.
dir: etc
bind: etc /etc
file: etc/nsswitch.conf
| passwd: files
| group: files
| shadow: files
| gshadow: files
| hosts: files
| networks: files
| protocols: files
| services: files
| ethers: files
| rpc: files
| netgroup: files
| aliases: files
file: etc/networks
| default\t\t0.0.0.0
| loopback\t127.0.0.0
| link-local\t169.254.0.0
arg: networks
status: exit 0
stdout:
| default               0.0.0.0
| loopback              127.0.0.0
| link-local            169.254.0.0
stderr:
