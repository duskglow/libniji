name: getent protocols by name, number and alias; one missing
clause: s31_4_g_1
command: getent
namespace: user
# A private /etc: nsswitch.conf names only the files service, so nothing depends on the host's
# configuration, network or name servers.
dir: etc
bind: etc /etc
file: etc/nsswitch.conf
| passwd: files
| group: files
| shadow: files
| gshadow: files
| hosts: files
| networks: files
| protocols: files
| services: files
| ethers: files
| rpc: files
| netgroup: files
| aliases: files
file: etc/protocols
| ip\t0\tIP
| icmp\t1\tICMP
| tcp\t6\tTCP
arg: protocols
arg: tcp
arg: 1
arg: ICMP
arg: 99
status: exit 2
stdout:
| tcp                   6 TCP
| icmp                  1 ICMP
| icmp                  1 ICMP
stderr:
