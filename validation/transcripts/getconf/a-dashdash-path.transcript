# UTIL-5: probe-settled behaviour of getconf (the reference as a black box).
name: getconf -a takes -- as its path operand
clause: s31_5_i_1
command: getconf
env: LC_ALL=C
# Values that depend on the host (limits, processors, memory, caches, the file system of the path):
# the record holds @HOST@; the reference and Liella run side by side are compared in full.
host-value: LINK_MAX                           
host-value: _POSIX_LINK_MAX                    
host-value: MAX_CANON                          
host-value: _POSIX_MAX_CANON                   
host-value: MAX_INPUT                          
host-value: _POSIX_MAX_INPUT                   
host-value: NAME_MAX                           
host-value: _POSIX_NAME_MAX                    
host-value: PATH_MAX                           
host-value: _POSIX_PATH_MAX                    
host-value: PIPE_BUF                           
host-value: _POSIX_PIPE_BUF                    
host-value: SOCK_MAXBUF                        
host-value: _POSIX_ASYNC_IO                    
host-value: _POSIX_CHOWN_RESTRICTED            
host-value: _POSIX_NO_TRUNC                    
host-value: _POSIX_PRIO_IO                     
host-value: _POSIX_SYNC_IO                     
host-value: _POSIX_VDISABLE                    
host-value: CHILD_MAX                          
host-value: OPEN_MAX                           
host-value: _NPROCESSORS_CONF                  
host-value: _NPROCESSORS_ONLN                  
host-value: _PHYS_PAGES                        
host-value: _POSIX_CHILD_MAX                   
host-value: _POSIX_OPEN_MAX                    
host-value: _POSIX_STREAM_MAX                  
host-value: STREAM_MAX                         
host-value: MQ_OPEN_MAX                        
host-value: RTSIG_MAX                          
host-value: SIGQUEUE_MAX                       
host-value: FILESIZEBITS                       
host-value: POSIX_ALLOC_SIZE_MIN               
host-value: POSIX_REC_INCR_XFER_SIZE           
host-value: POSIX_REC_MAX_XFER_SIZE            
host-value: POSIX_REC_MIN_XFER_SIZE            
host-value: POSIX_REC_XFER_ALIGN               
host-value: SYMLINK_MAX                        
host-value: POSIX2_SYMLINKS                    
host-value: LEVEL1_ICACHE_SIZE                 
host-value: LEVEL1_ICACHE_ASSOC                
host-value: LEVEL1_ICACHE_LINESIZE             
host-value: LEVEL1_DCACHE_SIZE                 
host-value: LEVEL1_DCACHE_ASSOC                
host-value: LEVEL1_DCACHE_LINESIZE             
host-value: LEVEL2_CACHE_SIZE                  
host-value: LEVEL2_CACHE_ASSOC                 
host-value: LEVEL2_CACHE_LINESIZE              
host-value: LEVEL3_CACHE_SIZE                  
host-value: LEVEL3_CACHE_ASSOC                 
host-value: LEVEL3_CACHE_LINESIZE              
host-value: LEVEL4_CACHE_SIZE                  
host-value: LEVEL4_CACHE_ASSOC                 
host-value: LEVEL4_CACHE_LINESIZE              
# Free memory changes between two runs on one host.
mask-value: _AVPHYS_PAGES                      
arg: -a
arg: --
status: exit 0
