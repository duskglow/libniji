# UTIL-5: probe-settled behaviour of getconf (the reference as a black box).
name: a system name with a path prints the usage text, status 2
clause: s31_5_f_2
command: getconf
env: LC_ALL=C
arg: ARG_MAX
arg: /
status: exit 2
stdout:
stderr:
| Usage: getconf [-v specification] variable_name [pathname]
| \x20      getconf -a [pathname]
