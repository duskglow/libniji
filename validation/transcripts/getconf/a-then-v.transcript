# UTIL-5: probe-settled behaviour of getconf (the reference as a black box).
name: getconf -a followed by -v prints the usage text
clause: s31_5_i_1
command: getconf
env: LC_ALL=C
arg: -a
arg: -v
arg: POSIX_V7_LP64_OFF64
status: exit 2
stdout:
stderr:
| Usage: getconf [-v specification] variable_name [pathname]
| \x20      getconf -a [pathname]
