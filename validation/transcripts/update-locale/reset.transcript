name: update-locale --reset comments out every variable not named
clause: s31_14_c_2
command: update-locale
file: conf
| LANG=C
| LC_NAME=C
| LC_TIME=POSIX
arg: --reset
arg: --locale-file=@ROOT@/conf
arg: LC_TIME=C
status: exit 0
stdout:
stderr:
written-file: conf
| #LANG=C
| #LC_NAME=C
| LC_TIME=C
