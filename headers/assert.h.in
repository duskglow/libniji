@@generated
/* assert.h: diagnostics (C 7.2). No include guard: C 7.2 says the macro is redefined each time the header is
   included, following the then current NDEBUG. Appendix C.9: assert calls __assert_fail (expression, file,
   line, function). */
#include <features.h>

#undef assert
#undef assert_perror

__NIJI_BEGIN_C

@@owns assert assert_perror __assert __assert_fail __assert_perror_fail
@@emit

/* The failure functions the macros call (LSB core: __assert_fail; they do not return). */
extern void __assert_fail (const char *__assertion, const char *__file, unsigned int __line, const char *__function) __NIJI_NOTHROW __attribute__ ((__noreturn__));
extern void __assert_perror_fail (int __errnum, const char *__file, unsigned int __line, const char *__function) __NIJI_NOTHROW __attribute__ ((__noreturn__));
extern void __assert (const char *__assertion, const char *__file, int __line) __NIJI_NOTHROW __attribute__ ((__noreturn__));

__NIJI_END_C

/* C 7.2.1.1: the C23 form takes the whole argument list as the expression (commas in it are not separators). */
#if __NIJI_ISOC >= 2023
# ifdef NDEBUG
#  define assert(...) ((void) 0)
# else
#  define assert(...) ((__VA_ARGS__) ? (void) 0 : __assert_fail (#__VA_ARGS__, __FILE__, __LINE__, __extension__ __func__))
# endif
#else
# ifdef NDEBUG
#  define assert(expr) ((void) 0)
# else
#  define assert(expr) ((expr) ? (void) 0 : __assert_fail (#expr, __FILE__, __LINE__, __extension__ __func__))
# endif
#endif

/* C 7.2 (C11, C17): static_assert expands to _Static_assert. Shown in the configurations where black-box probes of
   the reference show it (spec/abi/visibility.tsv): not strict C89 or C99, not C23 modes (a keyword there), not C++
   (a keyword). perl's perl.h tests `defined(static_assert)`. The levels table has no column for the language's own
   standard version, so the condition is written here: C11 names visible, and the language is neither C23 nor C++. */
@@owns static_assert
#if __NIJI_ISOC >= 2011 && !defined __cplusplus && !(defined __STDC_VERSION__ && __STDC_VERSION__ > 201710L)
# define static_assert _Static_assert
#endif

@@if assert_perror
# ifdef NDEBUG
#  define assert_perror(errnum) ((void) 0)
# else
#  define assert_perror(errnum) ((errnum) ? __assert_perror_fail ((errnum), __FILE__, __LINE__, __extension__ __func__) : (void) 0)
# endif
#endif
