/* C 7.2.1.1: the C23 form takes the whole argument list as the expression (commas in it are not separators). */
#if __NIJI_ISOC >= 2023
# ifdef NDEBUG
#  define assert(...) ((void) 0)
# else
#  define assert(...) ((__VA_ARGS__) ? (void) 0 : __assert_fail (#__VA_ARGS__, __FILE__, __LINE__, __extension__ __func__))
# endif
