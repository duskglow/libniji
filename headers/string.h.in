#  define __CORRECT_ISO_CPP_STRING_H_PROTO 1
extern "C++" {
extern const char *strchr (const char *, int) __NIJI_NOTHROW __asm__ ("strchr") @@attrs(strchr);
extern const char *strrchr (const char *, int) __NIJI_NOTHROW __asm__ ("strrchr") @@attrs(strrchr);
extern const char *strpbrk (const char *, const char *) __NIJI_NOTHROW __asm__ ("strpbrk") @@attrs(strpbrk);
extern const char *strstr (const char *, const char *) __NIJI_NOTHROW __asm__ ("strstr") @@attrs(strstr);
extern const void *memchr (const void *, int, size_t) __NIJI_NOTHROW __asm__ ("memchr") @@attrs(memchr);
inline @@attrs(strchr) char *strchr (char *__s, int __c) __NIJI_NOTHROW { return const_cast<char *> (strchr (static_cast<const char *> (__s), __c)); }
inline @@attrs(strrchr) char *strrchr (char *__s, int __c) __NIJI_NOTHROW { return const_cast<char *> (strrchr (static_cast<const char *> (__s), __c)); }
inline @@attrs(strpbrk) char *strpbrk (char *__s, const char *__a) __NIJI_NOTHROW { return const_cast<char *> (strpbrk (static_cast<const char *> (__s), __a)); }
inline @@attrs(strstr) char *strstr (char *__s, const char *__a) __NIJI_NOTHROW { return const_cast<char *> (strstr (static_cast<const char *> (__s), __a)); }
inline @@attrs(memchr) void *memchr (void *__s, int __c, size_t __n) __NIJI_NOTHROW { return const_cast<void *> (memchr (static_cast<const void *> (__s), __c, __n)); }
}
# else
extern char *strchr (const char *, int) __NIJI_NOTHROW @@attrs(strchr);
extern char *strrchr (const char *, int) __NIJI_NOTHROW @@attrs(strrchr);
extern char *strpbrk (const char *, const char *) __NIJI_NOTHROW @@attrs(strpbrk);
extern char *strstr (const char *, const char *) __NIJI_NOTHROW @@attrs(strstr);
extern void *memchr (const void *, int, size_t) __NIJI_NOTHROW @@attrs(memchr);
# endif
#endif

/* The GNU and BSD search functions take the same two overloads in C++ (black-box probe of the reference: `&F` is
   ambiguous, and a const argument gives a const result). index and rindex are <strings.h>'s too, under one guard. */
@@if strchrnul
# ifdef __cplusplus
extern "C++" {
extern const char *strchrnul (const char *, int) __NIJI_NOTHROW __asm__ ("strchrnul") @@attrs(strchrnul);
extern const char *strcasestr (const char *, const char *) __NIJI_NOTHROW __asm__ ("strcasestr") @@attrs(strcasestr);
