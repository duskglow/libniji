/* string.h: string handling (C 7.24, XSH <string.h>). In C++ the search functions are overloaded on the constness
   of their argument ([cstring.syn]): the const overload is the C function, the other one calls it. */
#ifndef __NIJI_H_string_h
#define __NIJI_H_string_h 1

#include <features.h>

__NIJI_BEGIN_C

@@owns NULL strchr strrchr strpbrk strstr memchr strdupa strndupa strchrnul strcasestr basename memrchr rawmemchr index rindex
@@emit
