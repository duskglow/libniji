@@null NULL
# endif
#endif

@@owns __CORRECT_ISO_CPP_STRING_H_PROTO
@@if strchr
# ifdef __cplusplus
/* Tells the C++ library's <cstring> that these overloads are declared here, so it declares none of its own in std
