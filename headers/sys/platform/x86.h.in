/* Per feature name (spec/abi/x86-features.tsv): the expression of CPU_FEATURE_PRESENT and CPU_FEATURE_ACTIVE. */
@@x86features

#define CPU_FEATURE_PRESENT(name) __NIJI_X86_P_##name
#define CPU_FEATURE_ACTIVE(name) __NIJI_X86_A_##name

