@@generated
/* sys/wait.h: waiting for child processes (XSH <sys/wait.h>, wait(2)). The configurations that show this header's
   signal names show the whole of <signal.h>, so it is included there, never copied. */
#ifndef __NIJI_H_sys_wait_h
#define __NIJI_H_sys_wait_h 1

#include <features.h>
@@needs-if SIGABRT signal.h

__NIJI_BEGIN_C

@@owns NULL WEXITSTATUS WTERMSIG WSTOPSIG WIFEXITED WIFCONTINUED WCOREDUMP
@@emit

@@if NULL
# ifndef NULL
#  ifdef __cplusplus
#   define NULL __null
#  else
#   define NULL ((void *) 0)
#  endif
# endif
#endif

/* The fields of the 16-bit wait status (wait(2)): the low 7 bits are the terminating signal, 0x7f there marks a
   stopped child, bit 7 a core dump; the next byte is the exit status or the stopping signal; 0xffff is a continued
   child. The first four are the same text as <stdlib.h>'s, so either header may come first. */
@@if WEXITSTATUS
# define WEXITSTATUS(status) (((status) & 0xff00) >> 8)
# define WTERMSIG(status) ((status) & 0x7f)
# define WSTOPSIG(status) WEXITSTATUS (status)
# define WIFEXITED(status) (WTERMSIG (status) == 0)
/* Signalled: a terminating signal other than 0 (exited) and 0x7f (stopped); one evaluation of the argument. */
# define WIFSIGNALED(status) ((unsigned int) (WTERMSIG (status) - 1) < 0x7eu)
# define WIFSTOPPED(status) (((status) & 0xff) == 0x7f)
#endif

@@if WIFCONTINUED
# define WIFCONTINUED(status) ((status) == 0xffff)
#endif

@@if WCOREDUMP
# define WCOREDUMP(status) ((status) & WCOREFLAG)
#endif

__NIJI_END_C

#endif
