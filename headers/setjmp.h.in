@@generated
/* setjmp.h: non-local jumps (C 7.13, XSH <setjmp.h>). Appendix C.9: setjmp(env) expands to _setjmp (env), which
   saves no signal mask; sigsetjmp (env, save) expands to __sigsetjmp (env, save). Both entry points can return
   twice. */
#ifndef __NIJI_H_setjmp_h
#define __NIJI_H_setjmp_h 1

#include <features.h>

__NIJI_BEGIN_C

@@owns-macro setjmp sigsetjmp
@@emit
@@fortify

/* C 7.13.1.1: setjmp is a macro. The function row of the table is the name POSIX also lets a program take the
   address of; the macro is what a call reaches. */
#define setjmp(env) _setjmp (env)

@@if sigsetjmp
# define sigsetjmp(env, savemask) __sigsetjmp (env, savemask)
#endif

__NIJI_END_C

#endif
