#!/bin/sh
# A C compiler driver that builds programs statically against libniji (validation, D-22.10: a
# static validation; dynamic linking waits for phase 14). Use it as CC for a configure script:
#
#   CC=/path/to/niji/scripts/niji-cc ./configure ...
#
# Compiling uses libniji's own C headers (plan/headers.md slice 20), as `conformance/run.sh
# --niji-headers` does: -nostdinc, then (C++ only) the C++ library's directories as the compiler
# lists them, the headers `cargo xtask so` staged in <products>/include, the compiler's own include
# directory and the staged kernel UAPI headers (<products>/uapi), appended after the program's own
# -I/-isystem directories. With -nostdinc among the arguments nothing is added; with -nostdinc++
# the C++ library's directories are left out. NIJI_SYSTEM_HEADERS=1 compiles with the system's
# headers instead (libniji is ABI-compatible with the glibc 2.39 headers), as before slice 20.
# Linking is what the C
# conformance suite does (conformance/run.sh): -static -nostdlib, libniji's start object first,
# the program's objects and libraries, then libniji's libc.a and libgcc. The libraries glibc
# splits out of libc (-lpthread, -lrt, -ldl, -lutil, -lanl, -lresolv, -lc) are dropped: their
# functions are in libc.a. -lm links libniji's libm.a (a product since D-10.7) in its place when
# the products have one; NIJI_CC_NO_LIBM=1 drops it as before libm existed (the labelled
# stand-in builds of validation/suite.sh, whose shim objects would collide with libm.a's one
# object). -lmvec is dropped (no libmvec product).
# Nothing of glibc's (libc.a, libm.a, crt1.o) is ever linked. Nothing is installed anywhere.
#
# Environment: NIJI_PRODUCTS (default: <repository>/target/niji, or $CARGO_TARGET_DIR/niji)
# names libc.a, libm.a and niji-crt1.o; NIJI_REAL_CC (default gcc) is the compiler;
# NIJI_CC_EXTRA, words added to every link just before libc.a (validation's labelled
# workarounds, validation/README.md: none by default).
set -eu
here=$(cd "$(dirname "$0")" && pwd)
products=${NIJI_PRODUCTS:-${CARGO_TARGET_DIR:-$here/../target}/niji}
cc=${NIJI_REAL_CC:-gcc}

# The header search path (appended). The language is C++ for a C++ compiler (NIJI_REAL_CC=g++),
# after `-x c++`, or for a C++ source name.
lang=c
case ${cc##*/} in *++) lang=c++ ;; esac
hdr=yes; cxxdirs=yes; prev=""
[ -n "${NIJI_SYSTEM_HEADERS:-}" ] && hdr=no
for a in "$@"; do
    case $prev:$a in
        -x:c++ | *:-xc++ | *:*.cc | *:*.cp | *:*.cxx | *:*.cpp | *:*.CPP | *:*.c++ | *:*.C | *:*.ii) lang=c++ ;;
    esac
    case $a in
        # -shared: a test's LD_PRELOAD library, built untouched as below.
        -nostdinc | -shared) hdr=no ;;
        -nostdinc++) cxxdirs=no ;;
    esac
    prev=$a
done
if [ $hdr = yes ]; then
    if [ ! -f "$products/include/features.h" ] || [ ! -d "$products/uapi" ]; then
        echo "niji-cc: $products/include or $products/uapi is missing (run cargo xtask so, or set NIJI_SYSTEM_HEADERS=1)" >&2
        exit 1
    fi
    gccinc=$("$cc" -print-file-name=include)
    set -- "$@" -nostdinc
    if [ $lang = c++ ] && [ $cxxdirs = yes ]; then
        # The compiler's own search list (its -v report), C++ library directories only.
        for d in $("$cc" -x c++ -E -v - </dev/null 2>&1 | sed -n '/^#include <\.\.\.> search starts here:/,/^End of search list\./s/^ \(.*\/c++\/.*\)/\1/p'); do
            set -- "$@" -isystem "$d"
        done
    fi
    set -- "$@" -isystem "$products/include" -isystem "$gccinc" -isystem "$products/uapi"
fi

link=yes
for a in "$@"; do
    case $a in
        -c | -S | -E | -M | -MM) link=no ;;
        # A shared object (a test's LD_PRELOAD library): a static program never loads one, so
        # it is built as the system compiler builds it, untouched.
        -shared) link=no ;;
    esac
done
if [ $link = no ]; then
    exec "$cc" "$@"
fi

for f in "$products/libc.a" "$products/niji-crt1.o"; do
    if [ ! -f "$f" ]; then
        echo "niji-cc: $f is missing (run cargo xtask so)" >&2
        exit 1
    fi
done

# Rebuild the arguments without the libraries libc.a replaces (order kept; arguments may
# contain blanks, so they are re-set one by one).
n=$#
i=0
while [ $i -lt $n ]; do
    a=$1
    shift
    i=$((i + 1))
    case $a in
        -lm)
            if [ -z "${NIJI_CC_NO_LIBM:-}" ] && [ -f "$products/libm.a" ]; then
                set -- "$@" "$products/libm.a"
            fi ;;
        -lpthread | -lrt | -ldl | -lutil | -lanl | -lresolv | -lc | -lmvec | -static | -pthread) ;;
        *) set -- "$@" "$a" ;;
    esac
done
# shellcheck disable=SC2086
# `-x none`: a `-x LANG` among the program's arguments must not make the files added here
# sources.
exec "$cc" -static -nostdlib -x none "$products/niji-crt1.o" "$@" -x none ${NIJI_CC_EXTRA:-} \
    -Wl,--start-group "$products/libc.a" -lgcc -Wl,--end-group
