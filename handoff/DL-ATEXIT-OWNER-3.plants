# DL-ATEXIT-OWNER-3 plants (docs/plants.md): the notice, the loader's report and the link-time interface (D-27.29).
notice-on-by-default | xtask/src/so.rs | lit:is_ok_and(|v| v == "1"); ==> is_ok_and(|v| v == "1") || true; | cargo xtask so && cargo test -p liella-boundary --test s01_startup_symbols s1_2_c_5_nonshared_notice | msg:default libc_nonshared.a carries a notice section
report-missing-at-start | crates/boundary/src/ld.rs | lit:report_nonshared(&o.elf, o.name); ==> let _ = o; | cargo xtask so && cargo test -p liella-boundary --test s01_startup_symbols s1_2_c_5_nonshared_notice | msg:start: the report must name the program once
report-missing-at-dlopen | crates/boundary/src/ld/dlopen.rs | lit:report_nonshared(&elf, shown); ==> let _ = shown; | cargo xtask so && cargo test -p liella-boundary --test s01_startup_symbols s1_2_c_5_nonshared_notice | msg:dlopen: the report must name the noticed library
report-without-setting | crates/ld/src/start.rs | lit:out.report_nonshared = report.is_some_and(|v| !v.is_empty()); ==> out.report_nonshared = true; | cargo xtask so && cargo test -p liella-boundary --test s01_startup_symbols s1_2_c_5_nonshared_notice | msg:the report printed without the setting
link-interface-not-default | xtask/src/so.rs | lit:.arg("-DLIELLA_OWNER_LINK_STUB") ==> .arg("-DLIELLA_OWNER_LINK_STUB_OFF") | cargo xtask so && cargo test -p liella-boundary --test s01_startup_symbols s1_2_c_5_owner_optin | msg:opted-in link failed|does not need LIELLA_OWNER_1
