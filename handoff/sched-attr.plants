# SCHED-ATTR plants (format: docs/plants.md): the sched_setattr / sched_getattr wrappers (crates/boundary/src/posix/s24_system.rs).
set-calls-get | crates/boundary/src/posix/s24_system.rs | lit:raw::syscall(nr::SCHED_SETATTR, ==> raw::syscall(nr::SCHED_GETATTR, | cargo test -p liella-boundary --test s24_system_symbols sym_sched_ | msg:sym_sched_setattr.*(FAILED|panicked)|panicked.*nice 5
set-drops-flags | crates/boundary/src/posix/s24_system.rs | lit:addr_word(attr.cast_const()), i64::from(flags), 0, 0, 0]) ==> addr_word(attr.cast_const()), 0, 0, 0, 0]) | cargo test -p liella-boundary --test s24_system_symbols sym_sched_ | msg:nonzero flags
set-hides-errors | crates/boundary/src/posix/s24_system.rs | perl:s/(nr::SCHED_SETATTR, \[[^\]]*\]\))\.map\(drop\)/$1.map(drop).or(Ok(()))/ | cargo test -p liella-boundary --test s24_system_symbols sym_sched_ | msg:sym_sched_setattr.*(FAILED|panicked)|EPERM|E2BIG|nice below
get-swaps-size-flags | crates/boundary/src/posix/s24_system.rs | lit:i64::from(size), i64::from(flags), 0, 0] ==> i64::from(flags), i64::from(size), 0, 0] | cargo test -p liella-boundary --test s24_system_symbols sym_sched_ | msg:sym_sched_(get|set)attr.*(FAILED|panicked)|errno 22
get-ignores-pid | crates/boundary/src/posix/s24_system.rs | lit:nr::SCHED_GETATTR, [i64::from(pid), ==> nr::SCHED_GETATTR, [0, | cargo test -p liella --test s24_system_clauses s24_3_c_6 | msg:the thread named by its ID
