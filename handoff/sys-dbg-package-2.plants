# SYS-DBG-PACKAGE-2 plants: the libc6-dbg packaging (tools/deb/system.sh) and the line tables of the
# release products (xtask/src/so.rs, RELEASE_DEBUG_RUSTFLAGS). The packaging plants repackage a fixed set of release products
# (built from the final head by the story's final job, copied to /mnt/zram/claude/SYS-DBG-PACKAGE-2/products-final) and run
# check-system.sh; the profile plant builds the release products in the copy (tools/deb/build.sh).
dbg-provides | tools/deb/system.sh | lit:"Provides: libc-dbg, libc6-dbgsym" \ ==> "Provides: libc-dbg" \ | rm -rf target/pd target/pw && NIJI_DEB_COMMIT=sysdbgpackage2 sh tools/deb/build.sh --flavour system --products /mnt/zram/claude/SYS-DBG-PACKAGE-2/products-final --version 2.39+niji20261116.1-1 --out target/pd --work target/pw && sh tools/deb/check-system.sh target/pd | msg:FAIL libc6-dbg: Provides
dbg-depends | tools/deb/system.sh | perl:s/(sys_control libc6-dbg amd64 debug optional \\\n\s+"Multi-Arch: same" \\\n\s+"Depends: libc6) \(= \$version\)"/$1"/ | rm -rf target/pd target/pw && NIJI_DEB_COMMIT=sysdbgpackage2 sh tools/deb/build.sh --flavour system --products /mnt/zram/claude/SYS-DBG-PACKAGE-2/products-final --version 2.39+niji20261116.1-1 --out target/pd --work target/pw && sh tools/deb/check-system.sh target/pd | msg:FAIL libc6-dbg: Depends
dbg-skip-ldd | tools/deb/system.sh | lit:"$bin/usr/bin/getent" "$bin/usr/bin/ldd"; do ==> "$bin/usr/bin/getent"; do | rm -rf target/pd target/pw && NIJI_DEB_COMMIT=sysdbgpackage2 sh tools/deb/build.sh --flavour system --products /mnt/zram/claude/SYS-DBG-PACKAGE-2/products-final --version 2.39+niji20261116.1-1 --out target/pd --work target/pw && sh tools/deb/check-system.sh target/pd | msg:FAIL libc6-dbg has no .* for /usr/bin/ldd
dbg-no-dwarf | tools/deb/system.sh | lit:objcopy --only-keep-debug --compress-debug-sections=zlib ==> objcopy --only-keep-debug --strip-debug | rm -rf target/pd target/pw && NIJI_DEB_COMMIT=sysdbgpackage2 sh tools/deb/build.sh --flavour system --products /mnt/zram/claude/SYS-DBG-PACKAGE-2/products-final --version 2.39+niji20261116.1-1 --out target/pd --work target/pw && sh tools/deb/check-system.sh target/pd | msg:FAIL .*no line tables
dbg-profile | xtask/src/so.rs | lit:const RELEASE_DEBUG_RUSTFLAGS: &str = "-Cdebuginfo=line-tables-only"; ==> const RELEASE_DEBUG_RUSTFLAGS: &str = "-Cdebuginfo=0"; | rm -rf target/pd target/pw && NIJI_DEB_COMMIT=sysdbgpackage2 SOURCE_DATE_EPOCH=1794870688 sh tools/deb/build.sh --flavour system --out target/pd --work target/pw && sh tools/deb/check-system.sh target/pd | msg:FAIL gdb .*shows no source line
