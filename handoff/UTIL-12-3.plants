# UTIL-12-3 plants: the shipped localedef's program glue (crates/boundary/src/localedef.rs), which only the shipped
# binary reaches, must be caught by xtask/tests/transcripts.rs the_shipped_localedef_passes_the_transcripts.
err-to-stdout | crates/boundary/src/localedef.rs | lit:write_all(2, r.err.as_slice()); ==> write_all(1, r.err.as_slice()); | cargo test -p xtask --test transcripts the_shipped_localedef | msg:the_shipped_localedef_passes_the_transcripts.*(FAILED|panicked)
status-lost | crates/boundary/src/localedef.rs | lit:exit(i32::from(r.status)) ==> exit(0) | cargo test -p xtask --test transcripts the_shipped_localedef | msg:the_shipped_localedef_passes_the_transcripts.*(FAILED|panicked)
errno-text | crates/boundary/src/localedef.rs | lit:niji::diag::description(errno) ==> niji::diag::description(0) | cargo test -p xtask --test transcripts the_shipped_localedef | msg:the_shipped_localedef_passes_the_transcripts.*(FAILED|panicked)
