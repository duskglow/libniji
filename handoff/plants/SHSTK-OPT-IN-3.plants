# SHSTK-OPT-IN-3 (D-27.97): an image-mode reader checked once, then given its spans.
spans-dropped | crates/ld/src/elf.rs | perl:s/self\.spans\.map\(\|_\| Elf \{ spans: Some\(spans\), \.\.self \}\)/self.spans.map(|_| self)/ | cargo test -p niji-ld --test reloc reloc_image_reader_slices_only_unchanging_segments | msg:reloc_image_reader_slices_only_unchanging_segments.*panicked|panicked.*reloc_image_reader_slices_only_unchanging_segments
file-reader-accepted | crates/ld/src/elf.rs | perl:s/self\.spans\.map\(\|_\| Elf \{ spans: Some\(spans\), \.\.self \}\)/Some(Elf { spans: Some(spans), ..self })/ | cargo test -p niji-ld --test reloc reloc_image_reader_slices_only_unchanging_segments | msg:a file reader does not become an image reader
